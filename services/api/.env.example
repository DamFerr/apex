# Copy this file to ".env" and fill it in. The ".env" file is git-ignored. NEVER share it or paste the key anywhere.
RIOT_API_KEY=
# Where to look first when searching for a player (the search itself works across all regions): euw1, eun1, na1, kr, ...
RIOT_PLATFORM=euw1
PORT=8787
# Starting limits (requests per second, per 2 minutes). Riot reports the key's real limits on every response and the
# service adopts them automatically, so a production key runs faster without any change here.
RATE_PER_SECOND=20
RATE_PER_2MIN=100

# The data collector starts by itself and covers every region and rank. All optional:
# COLLECT_DISABLED=1                         # do not collect (the app still works with what is stored)
# COLLECT_CONCURRENCY=4                      # parallel workers (Riot limits each region separately)
# COLLECT_ONLY_PLATFORMS=euw1,na1            # restrict to some regions
# COLLECT_ONLY_TIERS=EMERALD,DIAMOND         # restrict to some ranks
